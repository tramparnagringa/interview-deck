# Supabase (local: values printed by `pnpm db:start`)
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=
# Server only. Never expose to the client.
NUXT_SUPABASE_SECRET_KEY=

# Skool links (runtimeConfig.public.skool)
NUXT_PUBLIC_SKOOL_FREE_URL=https://www.skool.com/
NUXT_PUBLIC_SKOOL_PREMIUM_URL=https://www.skool.com/
NUXT_PUBLIC_SKOOL_LIVE_URL=https://www.skool.com/

# AI (server only)
NUXT_AI_ELEVENLABS_KEY=
NUXT_AI_ANTHROPIC_KEY=
# NUXT_AI_ANTHROPIC_MODEL=claude-sonnet-5
# NUXT_AI_ELEVENLABS_MODEL=scribe_v2
# Set to true to use fixed transcript/feedback (tests, local UI work without keys)
NUXT_AI_MOCK=false
