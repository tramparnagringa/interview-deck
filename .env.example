# Skool links (runtimeConfig.public.skool). Required to build the site.
# The community (Premium: share answers and get feedback; menu link).
NUXT_PUBLIC_SKOOL_URL=https://www.skool.com/tramparnagringa
# The plans page (Free: upgrade to Premium).
NUXT_PUBLIC_SKOOL_PLANS_URL=https://www.skool.com/tramparnagringa/plans

# Supabase project (sign in with Google, Premium members). Settings → API: Project URL and
# publishable (anon) key. Required to build the site. See docs/AUTH.md.
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=<publishable key>

# Only for `pnpm skool:import` on your machine (docs/AUTH.md). Secret: bypasses the database
# rules. Never add it to Vercel or use it in the app.
SUPABASE_SECRET_KEY=
